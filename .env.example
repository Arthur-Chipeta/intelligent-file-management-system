# Local PostgreSQL settings. On Render, use DATABASE_URL instead.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=intelligent_file_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-postgresql-password
# DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:5432/postgres

JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_UPLOAD_BYTES=20971520

# Use "local" for development and "supabase" on Render.
STORAGE_BACKEND=local
# UPLOAD_ROOT=C:/absolute/path/to/private/uploads
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-side-secret
SUPABASE_STORAGE_BUCKET=documents
